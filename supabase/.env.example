# cp supabase/.env.example supabase/.env, then npx supabase stop && npx supabase start
# GitHub OAuth app (https://github.com/settings/developers), callback URL: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=your-github-oauth-client-id
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=your-github-oauth-client-secret
