# Copy to .env.local and fill from `supabase status -o env`
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Seed script only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Production only: the fixed public origin (no trailing slash needed) and the Resend key for invite emails
JUNCTION_APP_URL=
RESEND_API_KEY=
# Production only: a random string; Vercel Cron sends it to /api/keepalive, which keeps a free Supabase project awake
CRON_SECRET=
